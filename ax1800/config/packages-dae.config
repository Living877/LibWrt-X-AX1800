# dae + LuCI 应用及其依赖
#
# 依赖关系（immortalwrt 25.12 源）：
#   luci-app-dae  -> +dae +dae-geoip +dae-geosite
#   dae           -> @HAS_BPF_TOOLCHAIN +@NEED_BPF_TOOLCHAIN
#                    +ca-bundle +kmod-sched-core +kmod-sched-bpf
#                    +kmod-xdp-sockets-diag +kmod-veth
#   dae-geoip     -> +dae +v2ray-geoip
#   dae-geosite   -> +dae +v2ray-geosite
#
# 用法：cat ax1800/config/packages-dae.config >> .config  然后 make defconfig
CONFIG_PACKAGE_dae=y
CONFIG_PACKAGE_luci-app-dae=y
CONFIG_PACKAGE_dae-geoip=y
CONFIG_PACKAGE_dae-geosite=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
