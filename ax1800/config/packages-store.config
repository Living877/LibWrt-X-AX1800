# iStore（luci-app-store）及其依赖（官方 linkease/istore 源）
#
# 前提：构建时把官方源加进 feeds.conf 并只装这几个包（见 README / build.yml）：
#   src-git istore https://github.com/linkease/istore.git
# 不要在 feeds.conf.default 里长期挂着第三方大 feed —— 会顶掉核心包，
# 而且 kiddin9 的 luci-app-store 副本带 @(x86_64||aarch64) 限制，在本树上会整包消失。
#
# 用法：cat ax1800/config/packages-store.config >> .config  然后 make defconfig
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
