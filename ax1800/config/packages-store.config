# iStore（luci-app-store）及其 kiddin9 依赖
#
# 前提：feeds.conf.default 里已追加
#   src-git kiddin9 https://github.com/kiddin9/op-packages.git
# 并且只从该 feed 装这几个包（见 README），不要 `feeds install -a -p kiddin9`：
# kiddin9 有 900 多个包、和上游重名 200 多个，整包安装会顶掉 luci-base 等核心包。
#
# 用法：cat ax1800/config/packages-store.config >> .config  然后 make defconfig
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
