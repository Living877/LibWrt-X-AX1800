#!/bin/sh
# 开机把 /etc/apk/world 里「源里不存在」的自编译包删掉。
#
# 背景：镜像里所有包都被写进 world，其中 31 个只在本机构建（NSS 那套 kmod、
# NSS 固件、iStore、本机 BDF 等），任何公开源里都没有。apk 每次事务都要解析
# 整个 world，解析失败就固定记 1 个 error —— 装包其实是成功的，只是退出码变 1。
#
# 这里只删 world 里的清单条目：不卸载包、不动文件，NSS 驱动照常加载。
# 幂等：world 里没有匹配项时什么都不写。名单见 /etc/apk/world.trim。

TRIM=/etc/apk/world.trim
WORLD=/etc/apk/world

[ -f "$TRIM" ] && [ -f "$WORLD" ] || exit 0

n=0
while IFS= read -r p; do
	case "$p" in ''|'#'*) continue ;; esac
	if grep -qxF "$p" "$WORLD"; then
		sed -i "\|^$p\$|d" "$WORLD"
		n=$((n + 1))
	fi
done < "$TRIM"

if [ "$n" -gt 0 ]; then
	command -v logger >/dev/null 2>&1 && \
		logger -t ax1800 "apk world 已裁掉 $n 个源里不存在的包"
fi

exit 0
